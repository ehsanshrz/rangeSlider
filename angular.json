{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "NpnSliderApp": {
      "root": "",
      "sourceRoot": "demo",
      "projectType": "application",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/NpnSliderApp",
            "index": "demo/index.html",
            "browser": "demo/main.ts",
            "tsConfig": "demo/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "demo/assets"
              },
              {
                "glob": "favicon.ico",
                "input": "demo"
              }
            ],
            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "demo/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "demo/environments/environment.ts",
                  "with": "demo/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "NpnSliderApp:build:production"
            },
            "development": {
              "buildTarget": "NpnSliderApp:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "NpnSliderApp:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "demo/test.ts",
            "tsConfig": "demo/tsconfig.spec.json",
            "karmaConfig": "demo/karma.conf.js",
            "styles": [
              "demo/styles.css"
            ],
            "scripts": [],
            "assets": [
              "demo/favicon.ico",
              "demo/assets"
            ]
          }
        }
      }
    }
  }
}
